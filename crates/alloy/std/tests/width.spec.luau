--!nonstrict
local Lest = require("@lest")
local describe, it, expect = Lest.describe, Lest.it, Lest.expect
local alloy = require("../alloy")
local Width = alloy.Width

describe("Width", function()
	it("wraps an integer as a buffer write does", function()
		expect(Width.wrap("u8", 300)).toBe(44)
		expect(Width.wrap("u8", -1)).toBe(255)
		expect(Width.wrap("i8", 128)).toBe(-128)
		expect(Width.wrap("i16", -32769)).toBe(32767)
		expect(Width.wrap("u32", 4294967296 + 5)).toBe(5)
		expect(Width.wrap("i32", 2147483648)).toBe(-2147483648)
		expect(Width.wrap("u8", 7.9)).toBe(7)
		expect(Width.wrap("u8", 0 / 0)).toBe(0)
		local b = buffer.create(2)
		buffer.writei16(b, 0, 40000)
		expect(Width.wrap("i16", 40000)).toBe(buffer.readi16(b, 0))
	end)

	it("saturates to the range", function()
		expect(Width.saturate("u8", 300)).toBe(255)
		expect(Width.saturate("u8", -4)).toBe(0)
		expect(Width.saturate("i16", 40000)).toBe(32767)
		expect(Width.saturate("i8", -3.7)).toBe(-3)
	end)

	it("rounds a float to f32", function()
		expect(Width.wrap("f32", 0.5)).toBe(0.5)
		expect(Width.wrap("f32", 0.1) == 0.1).toBe(false)
		expect(math.abs(Width.wrap("f32", 0.1) - 0.1) < 1e-8).toBe(true)
		expect(Width.wrap("f64", 0.1)).toBe(0.1)
	end)

	it("tells whether a value fits", function()
		expect(Width.fits("u8", 255)).toBe(true)
		expect(Width.fits("u8", 256)).toBe(false)
		expect(Width.fits("u8", 1.5)).toBe(false)
		expect(Width.fits("f32", 0.5)).toBe(true)
		expect(Width.fits("f32", 0.1)).toBe(false)
		expect(Width.fits("f64", 0.1)).toBe(true)
	end)

	it("gives the size and the range", function()
		expect(Width.size("u16")).toBe(2)
		expect(Width.size("f64")).toBe(8)
		expect(Width.min("i8")).toBe(-128)
		expect(Width.max("u32")).toBe(4294967295)
		expect(function()
			Width.size("u64")
		end).toThrow("is no width")
	end)
end)
