-- `@cfg` on a function with nothing to give returns where the
-- condition fails.
@cfg(server)
function save(player: Player)
    print(player)
end

@cfg(client and not studio)
local function hud()
end

-- One that owes the caller a value raises instead.
@cfg(server)
local function key(): string
    return "store"
end

-- `@cfg` on a local reads the value only where it holds.
@cfg(server)
const store = game:GetService("DataStoreService")

@cfg(any(studio, test))
local verbose = {
    level = 2,
}

-- `@cfg` on a statement skips the statement.
@cfg(server)
print(store)

@cfg(client)
if verbose then
    print(verbose)
end

print(save, hud, key, store, verbose)
