-- A module with TS-style exports.
-- Every exported name lands in one table returned at the end of scope.

export type Item = {
    read id: number,
    name: string,
    count: number,
}

export type Inventory = { [number]: Item }

export const MAX_STACK = 99

export local version = "1.0.0"

export function add(inv: Inventory, item: Item): Inventory
    local existing = inv[item.id]
    if existing then
        existing.count = math.min(existing.count + item.count, MAX_STACK)
    else
        inv[item.id] = item
    end
    return inv
end

local function count_all(inv: Inventory): number
    local total = 0
    for _, item in inv do
        total += item.count
    end
    return total
end

-- Re-export names bound earlier in the file.
export { count_all as total }
