-- Intrinsics have access to source text and position. The set is closed.
-- The spelling is a `$` prefix: `$dbg(x)`. Upstream never uses `$`.

local RunService = game:GetService("RunService")

local function compute(part: BasePart): number
    -- prints "07_intrinsics.aly:8: part.Size.Magnitude = 12.5" and returns it
    local size = $dbg(part.Size.Magnitude)
    return size * 2
end

local function serialize(part: BasePart): string
    -- emits: error("todo at 07_intrinsics.aly:14: needs a schema")
    $todo("needs a schema")
end

local function step(dt: number)
    -- emits: assert(dt > 0, "assertion failed: dt > 0")
    $assert(dt > 0)
end

local function check(a: Vector3, b: Vector3)
    -- On failure the message shows both source texts and both values.
    $assert_eq(a.Magnitude, b.Magnitude)
end

local function on_mode(mode: "client" | "server")
    if mode == "client" then
        print("client")
    elseif mode == "server" then
        print("server")
    else
        -- emits: error("unreachable at 07_intrinsics.aly:32")
        $unreachable()
    end
end

-- `$nameof` yields the last segment as a string. Renames stay in sync.
local field = $nameof(RunService.Heartbeat) -- "Heartbeat"

-- `$stringify` yields the source text of the expression.
local text = $stringify(1 + 2 * 3) -- "1 + 2 * 3"

-- A user function named like an intrinsic is a plain call without `$`.
local function dbg(x: number): number
    return x
end
local plain = dbg(1)

print(compute, serialize, step, check, on_mode, field, text, plain)
