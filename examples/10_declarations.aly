-- Declarations: `const`, destructuring, `new`, `delete`, Drop.

local count = 0
count += 1

-- `const` cannot be rebound. The value stays mutable, as upstream.
const settings = { volume = 0.5 }
settings.volume = 0.7
-- settings = {}  -- compile error: cannot assign to const

const function clamp01(x: number): number
    return math.clamp(x, 0, 1)
end

-- Destructuring uses upstream's proposed spelling.
-- emits: local _1 = settings local volume = _1.volume
local { volume } = settings

-- Rename with `=`. `:` stays a type annotation.
local { volume = level }: { volume: number } = settings

-- In parameters and for-loops.
local function distance({ x, y }: { x: number, y: number }): number
    return math.sqrt(x * x + y * y)
end

local points = { { x = 1, y = 2 }, { x = 3, y = 4 } }
for _, { x, y } in points do
    print(x, y)
end

-- `new Name(...)` is `Name.new(...)`. `new` stays a valid identifier.
local origin = new Vector3(0, 0, 0)
local part = new Instance("Part")
part.Position = origin

-- `new` is a reserved word, so it cannot name a binding; `Instance.new`
-- stays a field, as any reserved word does after a dot.
local make = Instance.new
local folder = make("Folder")

-- `delete expr` is `expr:Destroy()`.
delete part
delete folder

-- An Alloy struct opts in to `delete` through Drop, which emits Destroy.
struct Timer as
    connection: RBXScriptConnection?
end

impl Drop for Timer
    function drop(self)
        self.connection?:Disconnect()
    end

    function __call()
    end
end

local timer = new Timer { connection = nil }
delete timer

print(count, clamp01(2), volume, level, distance({ x = 3, y = 4 }))
