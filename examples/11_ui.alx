-- JSX on luaux. Markup lowers to the configured UI library.
-- Every luaux feature carries over. Alloy syntax works inside { } holes.

import * as React from "@packages/react"
import type { Item } from "./02_modules/inventory"

type Props = {
    items: Item[],
    title: string?,
    on_select: ((Item) -> ())?,
}

local function Row(props: { item: Item, on_select: ((Item) -> ())? })
    return (
        <TextButton
            Size={UDim2.new(1, 0, 0, 24)}
            Activated={function()
                props.on_select?(props.item)
            end}
        >
            {props.item.name} x{props.item.count}
        </TextButton>
    )
end

local function InventoryPanel(props: Props)
    local title = props.title ?? "Inventory"
    local rows = props.items:map(function(item)
        return <Row key={item.id} item={item} on_select={props.on_select} />
    end)

    return (
        <Frame Size={UDim2.fromScale(1, 1)} BackgroundTransparency={1}>
            <!-- a comment between tags -->
            <UIListLayout SortOrder={Enum.SortOrder.LayoutOrder} />
            <TextLabel Size={UDim2.new(1, 0, 0, 32)}>{title}</TextLabel>
            <TextLabel Visible={props.title ~= nil}>Showing {#props.items} items</TextLabel>
            {rows}
            <>
                <UICorner CornerRadius={UDim.new(0, 8)} />
            </>
            {if #props.items == 0 then <TextLabel>Empty</TextLabel> else nil}
            {match props.title with
                case "Shop" then <TextLabel>Welcome to the shop</TextLabel>
                default nil
            end}
        </Frame>
    )
end

return InventoryPanel
