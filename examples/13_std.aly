-- The standard library. Every name here is ambient: no import needed.
-- Emit adds one require of the std on the first code line.

-- Array literals are one-indexed tables with the shared Array metatable.
local xs = [ 1, 2, 3 ]
local grid = [ [ 1, 2 ], [ 3, 4 ] ]

-- `T[]` and `Array<T>` name the same type. `{ T }` is a raw table.
local a: number[] = [ 1 ]
local b: Array<number> = a
local c: { number } = b   -- an Array<T> is accepted as a { T }

-- An array index is a number. Both lines below are compile errors.
-- xs["foo"] = 1
-- local bad = xs.foo

-- Methods and free functions are the same functions.
local doubled = xs:map(function(x) return x * 2 end)
local same = Array.map(xs, function(x) return x * 2 end)
local total = xs:filter(function(x) return x % 2 == 1 end):reduce(function(acc, x) return acc + x end, 0)
xs:push(4)
local last = xs:pop()
print(#xs, xs:len(), xs:contains(2), last, same)

-- A raw table from the engine has no methods. Upgrade it in place, or use
-- the free form.
local children = Array.from(workspace:GetChildren())
local names = children:map(function(inst) return inst.Name end)
local raw_names = Array.map(workspace:GetChildren(), function(inst) return inst.Name end)
print(names:join(", "), raw_names:join(", "))

-- Construction with explicit type arguments uses upstream's <<T>> form.
local ids = new Array<<number>>()
local buffer = Array.with_capacity(64)
Array.push(ids, 1)

-- HashMap and Set are Alloy structs, so they carry methods.
local scores = new HashMap<<string, number>>()
scores:set("ana", 10)
scores:set("bo", 7)

local ana = scores:get("ana") ?? 0
for name, score in scores:entries() do
    print(name, score)
end

local hits = scores:get_or_insert("cy", 0)

local seen = Set.from([ 1, 2, 3 ])
seen:add(4)

local both = seen:intersection(Set.from([ 3, 4, 5 ]))
print(seen:has(2), both:len(), both:to_array())

-- Future is ambient too.
local ready = Future.resolve(42)
local timer = Future.delay(1)
local first = await Future.race([ ready, timer ])

-- `in` is membership, dispatched on the container at runtime.
local test = [ 3, 1, 2, 4 ]
if 3 in test then
    print("found")
end

print(2 in seen, "ana" in scores, "bc" in "abc", not (9 in test))

-- Symbol makes a unique key that no string can collide with.
local CHILDREN = Symbol.new("Children")
local props = { [CHILDREN] = [], Name = "x" }
print(tostring(CHILDREN), props[CHILDREN])

-- Result is ambient, with Ok and Err.
local parsed: Result<number, string> = Ok(1)
local value = parsed:map(function(n) return n + 1 end):unwrap_or(0)
local maybe: number? = parsed:ok()

print(doubled, total, ana, hits, first, value, maybe, buffer, grid, c)
