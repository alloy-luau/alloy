-- Sugar. Every form here is a shape Luau rejects today, with a one-line emit.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

-- Default parameters. The nil checks land on the `)` line.
-- emits: function move(part: BasePart, speed: number?, options)
--        if speed == nil then speed = 16 end if options == nil then options = {} end
local function move(part: BasePart, speed: number = 16, options = {})
    part.AssemblyLinearVelocity = Vector3.new(speed, 0, 0)
    return options
end

-- A default may use an earlier parameter.
-- `-> T` is the same as `: T` on any function.
local function pad(text: string, width: number = #text + 2) -> string
    return string.rep(" ", width - #text) .. text
end

-- Method reference. `obj:name` with no call binds `self`.
-- emits: button.Activated:Connect(bind(self, self.on_click))
struct Menu as
    button: TextButton
    opens: number = 0
end

impl Menu
    function on_click(self)
        self.opens += 1
    end

    function mount(self)
        self.button.Activated:Connect(self:on_click)
    end
end

-- String literal receiver. emits: ("abc"):upper()
local upper = "abc":upper()
local parts = `a,b,{upper}`:split(",")

-- Table spread through a typed helper. Metatables survive.
type Config = { volume: number, muted: boolean, name: string? }
local base: Config = { volume = 0.5, muted = false }
local loud = { ...base, volume = 1 }

-- `satisfies` checks without widening.
local config = { volume = 0.2, muted = true, name = "quiet" } satisfies Config

-- Optional call and optional-chain assignment.
type Handler = { on_done: ((number) -> ())?, target: { Health: number }? }
local function finish(handler: Handler)
    handler.on_done?(1)
    handler.target?.Health = 0
    handler.target?.Health += 1
end

-- `is` is a type test chosen by the name on the right. luau-lsp narrows
-- the branch for primitives, datatypes, Instance classes, and EnumItems.
local function describe(value: unknown) -> string
    if value is Part then
        return value.Name                       -- narrowed to Part
    elseif value is Vector3 then
        return tostring(value.Magnitude)
    elseif value is string then
        return value:upper()
    elseif value is Enum.KeyCode then
        return value.Name
    elseif value is Menu then
        return "a menu"                         -- runtime test, no narrowing
    elseif value is not nil then
        return "something"
    end
    return "nothing"
end

-- Bitwise word operators emit bit32 calls.
local READ, WRITE, EXEC = 1, 2, 4
local flags = READ bor WRITE
local can_write = (flags band WRITE) ~= 0
local toggled = flags bxor EXEC
local inverted = bnot flags
local shifted = 1 shl 4
local back = shifted shr 2

-- Array destructuring, with a rest binding.
local [ first, second ] = [ 10, 20, 30 ]
local [ head, ...rest ] = [ 1, 2, 3, 4 ]
local function pair([ x, y ]: number[]): number
    return x + y
end
for _, [ name, score ] in [ [ "ana", 3 ], [ "bo", 5 ] ] do
    print(name, score)
end

-- Loop filter. The guard lands on the `do` line.
for _, player in Players:GetPlayers() where player.Team ~= nil do
    print(player.Name)
end

-- `c ? a : b` is `if c then a else b`. A `:` that touches its receiver
-- stays a method call inside a branch; the else marker has a space before it.
local level = 7
local tier = level > 5 ? tostring(level):rep(2) : "low"
print(tier)

-- Struct field defaults fill in the raw constructor.
local menu = new Menu { button = new Instance("TextButton") }
print(menu.opens) -- 0

-- `async do` gives a Future from a block.
local loaded = async do
    local part = Workspace=>Map=>Spawn
    return part.Position
end

local spawn_position = await loaded

-- The object initializer: an optional table after any `new X(...)`.
-- Each field lands on its own line. `Parent` goes last.
local part = new Instance("Part") {
    Name = "Marker",
    Size = Vector3.new(1, 1, 1),
    Anchored = true,
    Parent = Workspace,
}

-- A struct constructs through `new` alone: the fields form when the
-- struct writes no constructor, `new Name(...)` when its impl does.
local menu2 = new Menu {
    button = Instance.new("TextButton"),
    opens = 3,
}

-- `read T[]` is the covariant read-only array. `write T[]` is a sink.
local function total(scores: read number[]) -> number
    return scores:reduce(function(acc, s) return acc + s end, 0)
end

-- `@derive` on an enum.
@derive(Debug, Eq)
enum Tile as
    Empty
    Wall(number)
end

print(move, pad("x"), upper, parts, loud, config, finish, can_write, toggled, inverted, back, describe)
local function collect(into: write number[])
    into:push(1)
end

print(first, second, head, rest, pair([ 1, 2 ]), spawn_position, part, menu2, total([ 1, 2 ]), collect, Tile.Wall(1) == Tile.Wall(1))
