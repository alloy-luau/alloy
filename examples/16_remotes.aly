-- Typed remotes. One file shows the shared declaration, the server, and
-- the client. In a project these are three modules.

-- 1. Shared declaration. Serializers are generated from the parameter
-- types. Each remote gets a stable id from a hash of package, module,
-- and name. In a project the sides live in `*.server.aly` and
-- `*.client.aly` files, which is what makes each side's surface a type.
-- This file uses `RunService` branches to show both in one place.

export remote Damage(target: Player, @u16 amount: number) from client
export remote Toast(message: string, seconds: number = 3) from server
export remote function GetProfile(id: number) -> Profile from client

-- Unreliable: the compiler errors when the packed size can pass 900 bytes.
@unreliable
export remote Position(cframe: CFrame) from client

-- Per-player token bucket. Excess drops and counts.
@ratelimit(20, 1)
export remote Chat(text: string) from client

-- `from client or server`: either side fires, either side handles. The server sees
-- the sender first; the client fires the payload alone. A rate limit
-- guards only the client-to-server direction.
@ratelimit(5, 1)
export remote Ping(sent_at: number) from client or server

-- Every call has a timeout, default 10 seconds. Functions ride the
-- RemoteEvent as request-id pairs, never a RemoteFunction.
@timeout(5)
export remote function Confirm(prompt: string): boolean from server

-- Server-side predicate on decoded arguments, after the shape check.
@validate(function(sender: Player, amount: number) return amount <= 100 end)
export remote Heal(@u8 amount: number) from client

-- Bypass the per-frame batch.
@immediate
export remote Fire(origin: Vector3, direction: Vector3) from client

-- Structs and enums serialize by their declarations.
@derive(Debug)
struct Profile as
    read id: number
    name: string
    level: number
    tags: string[]
end

enum Team as
    Red
    Blue
end

export remote JoinTeam(team: Team) from client

-- 2. Server. The handler always receives the sender first.

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

if RunService:IsServer() then
    Damage.on(function(sender: Player, target: Player, amount: number)
        print(`{sender.Name} hit {target.Name} for {amount}`)
    end)

    Chat.on(function(sender: Player, text: string)
        Toast.fire_except(sender, `{sender.Name}: {text}`, 4)
    end)

    Chat.on_ratelimited(function(sender: Player)
        warn(`{sender.Name} is chatting too fast`)
    end)

    -- An async handler: the runtime awaits the Future before it replies.
    GetProfile.on(async function(sender: Player, id: number): Profile
        local store = game:GetService("DataStoreService"):GetDataStore("profiles")
        local raw = store:GetAsync(`profile/{id}`)
        return new Profile { id = id, name = sender.Name, level = raw and raw.level or 1, tags = [] }
    end)

    JoinTeam.on(function(sender: Player, team: Team)
        print(sender.Name, team)
    end)

    Ping.on(function(sender: Player, sent_at: number)
        Ping.fire(sender, sent_at)   -- reply to that client only
    end)

    Toast.fire_all("Server started")
end

-- 3. Client. The surface exposes only what the direction allows.
-- `Damage.on` does not exist here; that is a type error.

if RunService:IsClient() then
    Toast.on(function(message: string, seconds: number)
        print(message, seconds)
    end)

    Confirm.on(function(prompt: string): boolean
        return true
    end)

    -- `call` returns a Future. Await it, or combine it.
    local profile = await GetProfile.call(1)
    print(profile)
    local both = await Future.all([ GetProfile.call(2), GetProfile.call(3) ])
    local safe = try await GetProfile.call(4)   -- Result on timeout or failure
    local pending = GetProfile.call(5)
    pending:cancel()
    Damage.fire(Players.LocalPlayer, 10)
    JoinTeam.fire(Team.Red)
    Position.fire(CFrame.new())
    Heal.fire(50)

    Ping.on(function(sent_at: number)
        print("round trip", os.clock() - sent_at)
    end)
    Ping.fire(os.clock())

    -- `wait` returns a Future of the next payload. `once` is the callback form.
    Toast.once(function(message) print("first toast", message) end)
    local message, seconds = await Toast.wait()
    print(message, seconds, both, safe)
end
