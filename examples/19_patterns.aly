-- Nested patterns, or-patterns, struct, table, and array patterns.

enum Shape as
    Circle(number)
    Rect(number, number)
end

enum Event as
    Spawn(Player, Vector3)
    Hit(Player, Shape)
    Leave(Player)
end

struct Config as
    name: string
    volume: number
end

-- Nested variant patterns.
local function describe(event: Event): string
    return match event with
        case Hit(p, Circle(r)) and r > 10 then `{p.Name} hit a big circle`
        case Hit(p, Circle(r)) then `{p.Name} hit a circle of {r}`
        case Hit(p, Rect(w, h)) then `{p.Name} hit a {w}x{h} rect`
        -- An or-pattern binds the same names on both sides.
        case Spawn(p, _) or Leave(p) then `{p.Name} moved`
    end
end

-- Result inside an optional-like enum.
enum Loaded as
    Some(Result<Config, string>)
    None
end

local function config_name(loaded: Loaded): string
    return match loaded with
        case Some(Ok({ name })) then name
        case Some(Err(message)) then `error: {message}`
        case Loaded.None then "not loaded"
        -- A table pattern is never exhaustive, so `default` is required.
        default "unknown"
    end
end

-- Struct patterns test the metatable, then bind fields.
local function loud(value: any): boolean
    return match value with
        case Config { volume } and volume > 0.8 then true
        case Config { name = "siren" } then true
        default false
    end
end

-- Table patterns test fields only. After `=` comes a pattern.
local function kind_of(t: { kind: string, size: number? }): string
    return match t with
        case { kind = "circle", size = _ } then "circle"
        case { kind = "rect", size } and size ~= nil then `rect of {size}`
        case { kind } then kind
        default "unknown"
    end
end

-- Array patterns, with a rest binding. An arm with a rest binding makes
-- the match exhaustive.
local function sum(xs: number[]): number
    return match xs with
        case [] then 0
        case [ x ] then x
        case [ x, ...rest ] then x + sum(rest)
    end
end

-- Literals nest anywhere. A dotted path always compares; a bare name
-- compares only when it names a variant in scope, else it binds.
local function is_origin(v: { x: number, y: number }): boolean
    return match v with
        case { x = 0, y = 0 } then true
        default false
    end
end

-- The Roblox enum lint: a match on Enum.X without `default` reports the
-- missing items from the API dump.
local function axis(key: Enum.KeyCode): number
    return match key with
        case Enum.KeyCode.W then 1
        case Enum.KeyCode.S then -1
        default 0
    end
end

print(describe, config_name, loud, kind_of, sum([ 1, 2, 3 ]), is_origin, axis)
