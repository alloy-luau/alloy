-- User-defined macros. A macro is a compile-time template with
-- expression parameters. A macro call is `$name(...)`. `!` is only ever
-- the non-nil assert. The sigil tells them apart with no name table.

-- An expression macro: the last statement is a bare expression.
macro clamp01(x)
    math.clamp(x, 0, 1)
end

-- A statement macro. `$stringify` and `$dbg` are intrinsics and may be
-- used inside a macro body.
macro log(expr)
    print(`[{script.Name}] {$stringify(expr)} = {expr}`)
end

-- A parameter used twice expands twice. Bind a local to evaluate once.
-- The local is renamed on expansion and never captures a caller's name.
macro square(x)
    local value = x
    value * value
end

-- Macros may call macros.
macro log_squared(x)
    $log($square(x))
end

-- A macro cannot capture a module local. This declaration is an error:
-- local factor = 2
-- macro scaled(x)
--     x * factor
-- end

-- A default parameter follows the function rule.
macro retry_count(n = 3)
    n
end

-- A macro body sees globals, not module locals, since it expands in
-- the calling file.
export macro assert_server()
    $assert(game:GetService("RunService"):IsServer())
end

-- Usage.

local speed = 24
local ratio = $clamp01(speed / 16)         -- math.clamp(speed / 16, 0, 1)
$log(ratio)                                -- print(`[...] ratio = {ratio}`)
local area = $square(speed + 1)            -- one evaluation of speed + 1
$log_squared(ratio)
local tries = $retry_count()

-- Highlighting, side by side. The first three are macro calls, by the
-- `$`. The rest are non-nil asserts, and an assert may be followed by a
-- call with no parentheses.
local a = $clamp01(ratio)
local b = $square(ratio)
$dbg(ratio)

type Handler = { on_done: ((number) -> ())?, target: BasePart? }
local handler: Handler = { on_done = nil, target = nil }
local part = handler.target!               -- assert, no call
local size = handler.target!.Size          -- assert, then index
local done = handler.on_done!(1)           -- assert, then call
handler.on_done?(2)                        -- call only when present

-- `handler.on_done(1)` with no `!` or `?` is the plain call, which
-- throws on nil like any Luau call.

print(ratio, area, tries, a, b, part, size, done)
