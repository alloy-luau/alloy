-- Signals. `Signal` is ambient std. It has the shape of RBXScriptSignal,
-- so code that takes either works with both.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- A signal carries typed payloads. The annotation names them; a handler
-- gets them typed.
local damaged: Signal<Player, number> = Signal.new()

local conn = damaged:Connect(function(player, amount)
    print(player.Name, "took", amount)
end)

damaged:Once(function(player)
    print("first hit on", player.Name)
end)

-- Fire runs every handler in connection order, each on its own thread.
damaged:Fire(Players:GetPlayers()[1], 10)
conn:Disconnect()

-- `collect` turns a signal, a Roblox signal included, into an iterator
-- over the events that queued since the last drain. A system reads them
-- once per frame, the way an ECS does.
local joined = Signal.collect(Players.PlayerAdded)
local hits = Signal.collect(damaged)

RunService.Heartbeat:Connect(function()
    for player in joined do
        print("joined", player.Name)
    end

    for player, amount in hits do
        print("hit", player.Name, amount)
    end
end)

-- `wrap` gives a Signal that fires with a Roblox signal. `Destroy`
-- disconnects from it.
local leaving = Signal.wrap(Players.PlayerRemoving)
leaving:Connect(function(player)
    print("left", player.Name)
end)

-- `Wait` yields until the next fire, with an optional timeout in seconds.
async function first_hit(): Player
    local player = damaged:Wait(5)
    return player
end

print(first_hit)
